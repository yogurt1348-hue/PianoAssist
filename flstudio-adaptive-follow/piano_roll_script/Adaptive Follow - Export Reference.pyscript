"""
Adaptive Follow - Export Reference (FL Studio Piano Roll script)

Exports the notes of the current Piano Roll as an Adaptive Follow reference
(JSON) into the Adaptive Follow user data folder. The Piano Roll is NOT
modified: notes are only read.

Uses only the documented ``flpianoroll`` API:
  score.PPQ, score.tsnum, score.tsden, score.noteCount, score.getNote(i),
  Note.number/time/length/velocity/color/group/muted,
  ScriptDialog(...).AddInputText/AddInputCombo/AddInputKnobInt/AddInputCheckbox,
  ScriptDialog.GetInputValue, Utils.ShowMessage / Utils.ProgressMsg.

Script structure: ``createDialog()`` builds the options dialog and
``apply(form)`` runs the export, which is how FL Studio runs Piano Roll
scripts with options (see INSTALL_WINDOWS.md for what to check in your FL
version).

Note: like every Piano Roll script, ``score`` is the current SELECTION, or
all notes when nothing is selected. Deselect everything (Ctrl+D) to export the
whole part.
"""

import flpianoroll as flp

EXPORTER_VERSION = "0.1.0"
COLOR_CHOICES = ["All notes"] + ["Only note color %d" % (i + 1) for i in range(16)]

_last_message = [""]


def _bootstrap():
    """Make the shared ``adaptive_follow`` package importable and return the data folder."""
    import sys
    lib = ""
    data = ""
    try:
        import adaptive_follow_paths as paths   # written next to this script by the installer
        lib = paths.LIB_DIR
        data = paths.DATA_DIR
    except Exception:
        try:
            import os
            appdata = os.environ.get("APPDATA", "")
            if appdata:
                lib = os.path.join(appdata, "AdaptiveFollow", "lib")
                data = os.path.join(appdata, "AdaptiveFollow")
        except Exception:
            pass
    if lib and lib not in sys.path:
        sys.path.insert(0, lib)
    return data


def _tell(text, popup):
    """Show the result once (apply() can be called repeatedly while editing options)."""
    try:
        flp.Utils.ProgressMsg(text.splitlines()[0], 1, 1)
    except Exception:
        pass
    if popup and text != _last_message[0]:
        _last_message[0] = text
        try:
            flp.Utils.ShowMessage(text)
        except Exception:
            print(text)
    else:
        print(text)


def createDialog():
    form = flp.ScriptDialog(
        "Adaptive Follow - Export Reference",
        "Exports the notes of this Piano Roll (selection, or all notes if nothing is selected) as the "
        "reference part you will play. The Piano Roll is not changed.")
    form.AddInputText("Reference name", "My part", "Name of the reference file (letters, digits, spaces)")
    form.AddInputCombo("Notes", COLOR_CHOICES, 0, "Export all notes or only one note color")
    form.AddInputKnobInt("Min velocity %", 0, 0, 100, 0, "Ignore notes softer than this (0 = keep all)")
    ppq = 96
    try:
        ppq = int(flp.score.PPQ)
    except Exception:
        pass
    form.AddInputKnobInt("Chord window (ticks)", max(1, ppq // 16), 0, max(1, ppq), 0,
                         "Notes starting within this many ticks of each other form one chord")
    form.AddInputCheckbox("Include muted notes", False, "Muted notes are skipped by default")
    return form


def _value(form, name, default):
    try:
        return form.GetInputValue(name)
    except Exception:
        return default


def apply(form):
    data_dir = _bootstrap()
    try:
        import adaptive_follow
        from adaptive_follow.reference import build_reference_from_notes, FILTER_ALL, FILTER_COLOR
        from adaptive_follow.storage import Storage
    except Exception as exc:
        _tell("Adaptive Follow is not installed correctly (cannot import the shared module: %r).\n"
              "Run tools\\install_windows.ps1 again." % (exc,), True)
        return

    name = str(_value(form, "Reference name", "My part") or "My part")
    combo = int(_value(form, "Notes", 0) or 0)
    min_vel = float(_value(form, "Min velocity %", 0) or 0) / 100.0
    window = int(_value(form, "Chord window (ticks)", 6) or 0)
    include_muted = bool(_value(form, "Include muted notes", False))

    try:
        ppq = int(flp.score.PPQ)
        count = int(flp.score.noteCount)
        notes = [flp.score.getNote(i) for i in range(count)]
    except Exception as exc:
        _tell("Adaptive Follow: cannot read the Piano Roll (%r)" % (exc,), True)
        return
    meta = {"exporter": "Adaptive Follow Piano Roll script %s" % EXPORTER_VERSION,
            "core": adaptive_follow.__version__, "source": "FL Studio Piano Roll", "notes_read": count}
    try:
        meta["time_signature"] = [int(flp.score.tsnum), int(flp.score.tsden)]
    except Exception:
        pass

    ref, report = build_reference_from_notes(
        notes, ppq, name=name,
        filter_mode=FILTER_ALL if combo == 0 else FILTER_COLOR, color=max(0, combo - 1),
        min_velocity=min_vel, include_muted=include_muted, chord_window_ticks=window, meta=meta)
    if ref is None:
        _tell("Adaptive Follow: nothing exported.\n" + "\n".join(report["errors"] + report["warnings"]), True)
        return
    try:
        storage = Storage(data_dir or None)
        path = storage.save_reference(ref)
    except Exception as exc:
        _tell("Adaptive Follow: could not save the reference (%r)" % (exc,), True)
        return
    lines = ["Adaptive Follow: exported %d notes (%d events) as '%s'." % (report["exported"], ref.event_count, ref.name),
             "File: %s" % path,
             "PPQ %d, chord window %d ticks, filter: %s." % (ppq, ref.chord_window_ticks, COLOR_CHOICES[combo])]
    skipped = report["skipped_filter"] + report["skipped_velocity"] + report["skipped_muted"]
    if skipped:
        lines.append("Skipped by filters: %d (color %d, velocity %d, muted %d)." % (
            skipped, report["skipped_filter"], report["skipped_velocity"], report["skipped_muted"]))
    lines.extend(report["warnings"])
    lines.append("The reference does not update automatically: export again after editing the part.")
    _tell("\n".join(lines), True)

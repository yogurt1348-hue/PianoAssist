{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "tests-only",
      "displayName": "Domain libraries and tests only (any OS, no JUCE)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tests-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PIANOASSIST_BUILD_APP": "OFF"
      }
    },
    {
      "name": "linux-app",
      "displayName": "Linux app build (developer check only, not a release target)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-app",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "tests-only", "configurePreset": "tests-only" },
    { "name": "linux-app", "configurePreset": "linux-app" }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    { "name": "tests-only", "configurePreset": "tests-only", "output": { "outputOnFailure": true } },
    { "name": "linux-app", "configurePreset": "linux-app", "output": { "outputOnFailure": true } }
  ]
}
